8177","https://openalex.org/W6856141161","https://openalex.org/W6856304189","https://openalex.org/W6856547945","https://openalex.org/W6856700136","https://openalex.org/W6856762916","https://openalex.org/W6857221871","https://openalex.org/W6857241699","https://openalex.org/W6857318677","https://openalex.org/W6857355424","https://openalex.org/W6857433768","https://openalex.org/W6857532327","https://openalex.org/W6857665103","https://openalex.org/W6857685617","https://openalex.org/W6857875326","https://openalex.org/W7015553442","https://openalex.org/W7133185504","https://openalex.org/W7133190699","https://openalex.org/W7133205816","https://openalex.org/W7133216411","https://openalex.org/W7133220370","https://openalex.org/W7133223432","https://openalex.org/W7133238707","https://openalex.org/W7133245972","https://openalex.org/W7134583938"],"reviewed_benchmark_cells":[],"source":"arxiv","tags":["Diffusion","Avatars","Foundations"],"title":"GaussianDreamer: Fast Generation from Text to 3D Gaussians by Bridging 2D and 3D Diffusion Models","tldr":"In recent times the generation of 3D assets from text prompts has shown impressive results.","updated_date":"2024-05-13","venue":"CVPR 2024","year":2023},"2310.10642":{"abstract":"Reconstructing dynamic 3D scenes from 2D images and generating diverse views over time is challenging due to scene complexity and temporal dynamics. Despite advancements in neural implicit models, limitations persist: (i) Inadequate Scene Structure: Existing methods struggle to reveal the spatial and temporal structure of dynamic scenes from directly learning the complex 6D plenoptic function. (ii) Scaling Deformation Modeling: Explicitly modeling scene element deformation becomes impractical for complex dynamics. To address these issues, we consider the spacetime as an entirety and propose to approximate the underlying spatio-temporal 4D volume of a dynamic scene by optimizing a collection of 4D primitives, with explicit geometry and appearance modeling. Learning to optimize the 4D primitives enables us to synthesize novel views at any desired time with our tailored rendering routine. Our model is conceptually simple, consisting of a 4D Gaussian parameterized by anisotropic ellipses that can rotate arbitrarily in space and time, as well as view-dependent and time-evolved appearance represented by the coefficient of 4D spherindrical harmonics. This approach offers simplicity, flexibility for variable-length video and end-to-end training, and efficient real-time rendering, making it suitable for capturing complex dynamic scene motions. Experiments across various benchmarks, including monocular and multi-view scenarios, demonstrate our 4DGS model's superior visual quality and efficiency.","arxiv_doi":"10.48550/arxiv.2310.10642","arxiv_id":"2310.10642","authors":["Zeyu Yang","Hongye Yang","Zijie Pan","Li Zhang"],"categories":["Dynamic & 4DGS","Foundations & Acceleration"],"citation_count":293,"citation_fetched_at":"2026-11-11T04:46:40.793522+00:00","citation_status":"ok","code_url":null,"comment":"ICLR 2024","date_placement":"observed","db_citation_count":178,"db_citations":["2310.08528","2311.11700","2311.12198","2311.12897","2311.14521","2311.16096","2311.16099","2311.17113","2312.00112","2312.00732","2312.02126","2312.02973","2312.03461","2312.05664","2312.09228","2312.14937","2312.16084","2401.11535","2401.15318","2401.16663","2402.07181","2402.15870","2402.17427","2403.01444","2403.04116","2403.08321","2403.08551","2403.11134","2403.11273","2403.12365","2403.12722","2403.14621","2403.15530","2403.15624","2403.19586","2403.20159","2404.03613","2404.04687","2404.04908","2404.06109","2404.12379","2404.16012","2405.14276","2405.15125","2405.17421","2405.17872","2405.19321","2405.19745","2406.00440","2406.02972","2406.09395","2406.10111","2407.03771","2407.11793","2407.17418","2408.03538","2408.11697","2408.13036","2409.01581","2409.07759","2409.08270","2409.18852","2410.12262","2410.13607","2410.20789","2410.20815","2410.22070","2411.03706","2411.06602","2411.14384","2411.16180","2411.18072","2412.00734","2412.03526","2412.03910","2412.06257","2412.06299","2412.08331","2412.11752","2412.17532","2412.18862","2501.00326","2501.01895","2501.03875","2501.19196","2502.03465","2503.08166","2503.09332","2503.11345","2503.13948","2503.16338","2503.16422","2503.17973","2503.20776","2503.21779","2504.00763","2505.13215","2505.16533","2505.18649","2506.05011","2506.05348","2506.07069","2506.09997","2506.20998","2506.21520","2506.22756","2507.02363","2507.05859","2507.07465","2507.14501","2507.17336","2507.18023","2507.19133","2508.07182","2508.19243","2509.00831","2509.10759","2509.12938","2509.14739","2509.17864","2509.22222","2509.23492","2510.01119","2510.07752","2510.14705","2510.23087","2511.05152","2511.05229","2511.07122","2511.13571","2511.18367","2511.22939","2512.07197","2512.08478","2512.10424","2512.11356","2512.14352","2512.20943","2602.08558","2602.18886","2602.21668","2602.23040","2603.00952","2603.02887","2603.07587","2603.11298","2603.11543","2603.18402","2603.23686","2603.24036","2604.00538","2604.01678","2604.04016","2604.06358","2604.07882","2604.13746","2604.22339","2605.10307","2605.11427","2605.22190","2605.30065","2605.30855","2606.00452","2606.22197","2607.18466","2607.27634","2608.01958","2608.02006","2608.02099","2608.16324","2608.30184","2609.24531","cvf:Bulo_Hardware-Rasterized_Ray-Based_Gaussian_Splatting_CVPR_2025_paper","cvf:Kwak_MoDec-GS_Global-to-Local_Motion_Decomposition_and_Temporal_Interval_Adjustment_for_Compact_CVPR_2025_paper","cvf:Li_GIFStream_4D_Gaussian-based_Immersive_Video_with_Feature_Stream_CVPR_2025_paper","paper:2025-67ae48cbf8","paper:2025-e8a7c16f09","paper:2026-4e8bafd83b"],"db_references":[],"doi":null,"first_author":"Yang et al.","huggingface":{"fetched_at":"2026-11-14T11:22:02.639836+00:00","last_attempt_at":"2026-11-14T11:22:02.639836+00:00","linked_spaces":[],"linked_spaces_complete":true,"linked_spaces_total":0,"project_page_evidence":null,"provider_ai_summary":{"provider":"huggingface","source_url":"https://huggingface.co/papers/2310.10642","text":"A 4D Gaussian and spherindrical harmonics model is proposed to optimize spatio-temporal primitives for dynamic scene reconstruction and view generation."},"provider_summary":{"provider":"huggingface","source_url":"https://huggingface.co/papers/2310.10642","text":"Reconstructing dynamic 3D scenes from 2D images and generating diverse views\nover time is challenging due to scene complexity and temporal dynamics. Despite\nadvancements in neural implicit models, limitations persist: (i) Inadequate\nScene Structure: Existing methods struggle to reveal the spatial and temporal\nstructure of dynamic scenes from directly learning the complex 6D plenoptic\nfunction. (ii) Scaling Deformation Modeling: Explicitly modeling scene element\ndeformation becomes impractical for complex dynamics. To address these issues,\nwe consider the spacetime as an entirety and propose to approximate the\nunderlying spatio-temporal 4D volume of a dynamic scene by optimizing a\ncollection of 4D primitives, with explicit geometry and appearance modeling.\nLearning to optimize the 4D primitives enables us to synthesize novel views at\nany desired time with our tailored rendering routine. Our model is conceptually\nsimple, consisting of a 4D Gaussian parameterized by anisotropic ellipses that\ncan rotate arbitrarily in space and time, as well as view-dependent and\ntime-evolved appearance represented by the coefficient of 4D spherindrical\nharmonics. This approach offers simplicity, flexibility for variable-length\nvideo and end-to-end training, and efficient real-time rendering, making it\nsuitable for capturing complex dynamic scene motions. Experiments across\nvarious benchmarks, including monocular and multi-view scenarios, demonstrate\nour 4DGS model's superior visual quality and efficiency."},"repository_evidence":{"ownership":"unverified","url":"https://github.com/fudan-zvg/4d-gaussian-splatting"},"source_url":"https://huggingface.co/papers/2310.10642","stars":1056,"status":"ok","submitted_on_daily_at":null,"upvotes":2},"id":"2310.10642","influential_citation_count":0,"metadata_evidence":{"published_date":[{"observed_at":null,"reviewed_at":null,"reviewed_by":null,"source":"arxiv","source_url":"http://arxiv.org/abs/2310.10642v3","value":"2023-10-16"}],"venue":[{"observed_at":null,"reviewed_at":null,"reviewed_by":null,"source":"author_comment","source_url":"https://arxiv.org/abs/2310.10642","value":"ICLR 2024"}]},"month":10,"openalex_id":"https://openalex.org/W4387725608","paper_url":"https://arxiv.org/abs/2310.10642","pdf_url":"https://arxiv.org/pdf/2310.10642.pdf","primary_arxiv_category":"cs.CV","primary_category":"Dynamic & 4DGS","project_url":null,"publication_date":null,"publication_date_precision":"unknown","publication_year":null,"published_date":"2023-10-16","published_date_precision":"day","referenced_works":[],"reviewed_benchmark_cells":[],"source":"arxiv","tags":["4DGS","Foundations"],"title":"Real-time Photorealistic Dynamic Scene Representation and Rendering with 4D Gaussian Splatting","tldr":"Learning to optimize the 4D primitives enables us to synthesize novel views at any desired time with our tailored rendering routine.","updated_date":"2024-02-22","venue":"ICLR 2024","year":2023},"2310.19441":{"abstract":"Easy access to precise 3D tracking of movement could benefit many aspects of rehabilitation. A challenge to achieving this goal is that while there are many datasets and pretrained algorithms for able-bodied adults, algorithms trained on these datasets often fail to generalize to clinical populations including people with disabilities, infants, and neonates. Reliable movement analysis of infants and neonates is important as spontaneous movement behavior is an important indicator of neurological function and neurodevelopmental disability, which can help guide early interventions. We explored the application of dynamic Gaussian splatting to sparse markerless motion capture (MMC) data. Our approach leverages semantic segmentation masks to focus on the infant, significantly improving the initialization of the scene. Our results demonstrate the potential of this method in rendering novel views of scenes and tracking infant movements. This work paves the way for advanced movement analysis tools that can be applied to diverse clinical populations, with a particular emphasis on early detection in infants.","arxiv_doi":"10.48550/arxiv.2310.19441","arxiv_id":"2310.19441","authors":["R. James Cotton","Colleen Peyton"],"categories":["Dynamic & 4DGS","Medical, Defense & Multimodal Sensors"],"citation_count":1,"citation_fetched_at":"2026-11-11T04:46:40.793522+00:00","citation_status":"ok","code_url":null,"comment":null,"date_placement":"observed","db_citation_count":1,"db_citations":["2401.05345"],"db_references":[],"doi":null,"first_author":"Cotton et al.","huggingface":{"fetched_at":null,"last_attempt_at":"2026-11-14T11:22:02.639836+00:00","linked_spaces":null,"linked_spaces_complete":null,"linked_spaces_total":null,"project_page_evidence":null,"provider_ai_summary":null,"provider_summary":null,"repository_evidence":null,"source_url":"https://huggingface.co/papers/2310.19441","stars":null,"status":"not_found","submitted_on_daily_at":null,"upvotes":null},"id":"2310.19441","influential_citation_count":0,"metadata_evidence":{"published_date":[{"observed_at":null,"reviewed_at":null,"reviewed_by":null,"source":"arxiv","source_url":"http://arxiv.org/abs/2310.19441v1","value":"2023-10-30"}]},"month":10,"openalex_id":"https://openalex.org/W4388093482","paper_url":"https://arxiv.org/abs/2310.19441","pdf_url":"https://arxiv.org/pdf/2310.19441.pdf","primary_arxiv_category":"cs.CV","primary_category":"Dynamic & 4DGS","project_url":null,"publication_date":null,"publication_date_precision":"unknown","publication_year":null,"published_date":"2023-10-30","published_date_precision":"day","referenced_works":["https://openalex.org/W2010394425","https://openalex.org/W2103589991","https://openalex.org/W2737258237","https://openalex.org/W2996114784","https://openalex.org/W3136205090","https://openalex.org/W3156454664","https://openalex.org/W3204727593","https://openalex.org/W3214048675","https://openalex.org/W3215362479","https://openalex.org/W4330339510","https://openalex.org/W4391845811"],"reviewed_benchmark_cells":[],"source":"arxiv","tags":["4DGS","Foundations"],"title":"Dynamic Gaussian Splatting from Markerless Motion Capture can Reconstruct Infants Movements","tldr":"Easy access to precise 3D tracking of movement could benefit many aspects of rehabilitation.","updated_date":"2023-10-30","venue":null,"year":2023}}