s://openalex.org/W4402727930","https://openalex.org/W4402733571","https://openalex.org/W4402774699","https://openalex.org/W4413557100","https://openalex.org/W6729001083","https://openalex.org/W6754172994","https://openalex.org/W6774937992","https://openalex.org/W6802668286","https://openalex.org/W6853592262","https://openalex.org/W7015553442","https://openalex.org/W7133190699","https://openalex.org/W7133199285","https://openalex.org/W7133218093","https://openalex.org/W7133245003"],"reviewed_benchmark_cells":[],"source":"arxiv","tags":["Diffusion","Foundations"],"title":"Control4D: Efficient 4D Portrait Editing with Text","tldr":"Introduces Control4D, an innovative framework for editing dynamic 4D portraits using text instructions.","updated_date":"2023-11-30","venue":null,"year":2023}}