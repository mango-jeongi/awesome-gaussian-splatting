[Unit]
Description=Bounded papers PDF extraction pass

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/papers-worker/current
Environment=UV_PROJECT_ENVIRONMENT=%h/.venvs/papers-worker
ExecStart=%h/.local/bin/uv run --no-sync --group extraction python -m src.workers pass --queue %h/.local/share/papers-worker/state --cache %h/.cache/papers-worker/pdfs --max-jobs 4
Restart=on-failure
RestartSec=15
TimeoutStartSec=15min
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
Nice=10
MemoryMax=2G
CPUQuota=150%
