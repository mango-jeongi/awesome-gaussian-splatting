* text=auto
.gitattributes text eol=lf
*.py text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Content-addressed evidence must retain exact bytes on every platform.
data/** -text -whitespace
docs/data/** -text -whitespace
docs/papers.json -text -whitespace
tests/fixtures/** -text -whitespace
reports/relevance/** -text -whitespace
reports/runs/** -text -whitespace

scripts/worker/*.service text eol=lf
scripts/worker/gemma-radsplat-page6-request.json -text -whitespace
reports/public-manifests/** -text -whitespace
